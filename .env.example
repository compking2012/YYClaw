# ClawX Environment Variables

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789

# Development Configuration
VITE_DEV_SERVER_PORT=5173

# Feishu / Lark creator application (required for Feishu channel auto-create & OAuth login)
# Get these from https://open.feishu.cn -> your app -> Credentials & Basic Info.
# Never hardcode the secret in source: it is scanned and blocked by GitHub push protection.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
# Tenant-level IT admin user_id (not open_id) used to auto-approve app versions
FEISHU_IT_USER_ID=xxxxxxxx

# Release Configuration (CI/CD)
# Apple Developer Credentials
APPLE_ID=your@email.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Code Signing Certificate
CSC_LINK=path/to/certificate.p12
CSC_KEY_PASSWORD=certificate_password

# GitHub Token for releases
GH_TOKEN=github_personal_access_token
