# Compile-time feature switches (committed file).
# After changing any value: run `pnpm run init`, then rebuild (pnpm dev / pnpm run build:vite / ./build_rel.sh).

# Office Collaboration feature visibility (compile-time; rebuild after change)
# - When false: Office hidden in sidebar and all Office APIs disabled
# - When true or unset: Office fully enabled and sidebar entry visible
VITE_SHOW_OFFICE_COLLABORATION=true

# Office internal session visibility in chat sidebar
# - When false (default): office:task / task-room / p2p / role sessions are hidden from the left session list
# - When true: office runtime sessions appear in the sidebar like normal chat sessions
VITE_SHOW_OFFICE_SESSIONS=false

# Workflow user checkpoint (human review gate after node completion)
# - When false: no review batch / hold behavior (default)
# - When true: Legacy DAG runner pauses for structured human review when nodes have userCheckpoint
OFFICE_USER_CHECKPOINT=false


# LangGraph workflow engine support
# - When false: LangGraph dependencies not downloaded, not compiled, runtime features hidden
# - When true: LangGraph enabled (requires pnpm run init to download dependencies)
VITE_ENABLE_LANGGRAPH=false

