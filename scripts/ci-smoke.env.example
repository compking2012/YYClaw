# Copy to scripts/ci-smoke.env (gitignored) for local / shell-runner smoke tests.
# GitLab CI should use masked variable SMOKE_GLM_API_KEY instead.
# Defaults target domestic GLM-5.2 (vendor glm52 / model glm-5.2).
export SMOKE_GLM_API_KEY='sk-your-glm-key-here'
export SMOKE_GLM_BASE_URL='https://claw-x.com/v1'
# Optional overrides:
# export SMOKE_GLM_VENDOR_ID='glm52'
# export SMOKE_GLM_MODEL_ID='glm-5.2'
# export SMOKE_GLM_LABEL='国内GLM-5.2模型'
