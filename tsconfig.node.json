{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist-electron",
    "declaration": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@electron/*": ["electron/*"],
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["electron", "shared", "shared/**/*.json", "vite.config.ts", "types/**/*.d.ts", "src/types/electron.d.ts"],
  "exclude": ["electron/services/admin-console/**"]
}
