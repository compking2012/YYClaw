{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@electron/*": ["electron/*"],
      "@shared/*": ["shared/*"]
    }
  },
  /*
   * Scope: the shared E2E harness, not every spec.
   *
   * `tests/e2e/fixtures/**` is the foundation every Electron spec launches
   * through, so a broken symbol here silently disables the entire suite (an
   * undefined `allocatePort` did exactly that, and neither tsconfig.node.json
   * nor tsconfig.web.json covers `tests/`, so CI never saw it).
   *
   * Individual specs and `tests/unit` are intentionally out of scope for now:
   * they carry a large backlog of pre-existing loose typing (~350 errors,
   * mostly inferred literals vs. declared mock shapes) that has to be cleaned
   * up before they can join a strict project. Tracked in docs/FEATURELIST.md.
   */
  "include": [
    "tests/e2e/fixtures",
    "tests/e2e/parallel-policy.ts",
    "playwright.config.ts",
    "types/**/*.d.ts",
    "src/vite-env.d.ts",
    "src/types/electron.d.ts",
    "electron/types/raw-import.d.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
